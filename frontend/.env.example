# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==========================================
# Copy these keys into your Vercel or Render Dashboard (Environment variables)

# Your live backend URL. No trailing slash!
# Example: https://bookease-backend.onrender.com
VITE_BACKEND_URL=your_live_backend_url

# Razorpay Key ID (Must match the one in backend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
