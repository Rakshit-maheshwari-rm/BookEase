# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================
# Copy these keys into your Render Dashboard (Environment tab)

# MongoDB connection string (from MongoDB Atlas)
MONGO_URL=your_mongodb_atlas_connection_string

# Session secret (Any strong random string)
SECRET=your_random_secret_key_here

# The port your server runs on (Render assigns this automatically, but you can set it)
PORT=8000

# Your live frontend URL (Crucial for CORS). No trailing slash!
# Example: https://bookease-frontend.vercel.app
FRONT_URL=your_live_frontend_url

# Razorpay Keys (From Razorpay Dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Keys (From Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
